<?xml version="1.0"?>
<package format="3">
  <name>fast_livo</name>
  <version>0.0.0</version>

  <description>
    This is a modified version of LOAM which is original algorithm
    is described in the following paper:
    J. Zhang and S. Singh. LOAM: Lidar Odometry and Mapping in Real-time.
      Robotics: Science and Systems Conference (RSS). Berkeley, CA, July 2014.
  </description>

  <maintainer email="dev@livoxtech.com">claydergc</maintainer>

  <license>BSD</license>

  <author email="zhangji@cmu.edu">Ji Zhang</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>rclcpp</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>livox_ros_driver2</depend>

  <!-- Vendored sub-tree: rpg_vikit (Robotic-Developer-Road fork, patched
       to ament_cmake -- see src/rpg_vikit/{vikit_common,vikit_ros}/package.xml
       for the patches themselves). Brought in via add_subdirectory(rpg_vikit)
       at gs-livo/CMakeLists.txt:103, not via colcon's normal src/ walker. -->
  <depend>vikit_common</depend>
  <depend>vikit_ros</depend>

  <!-- fmt: required by vikit_common/CMakeLists.txt (find_package(fmt REQUIRED)
       at its :34). Not previously declared here because the build was never
       attempted with rpg_vikit actually present; declare now to make it
       explicit. -->
  <depend>libfmt-dev</depend>

  <!-- EIGEN3_INCLUDE_DIR / PCL_INCLUDE_DIRS in CMakeLists.txt are legacy
       variable-based usage -- declare the apt-side package so the find works
       under a clean install. -->
  <depend>eigen</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- The <export><build_type>ament_cmake</build_type></export> block was
       removed because ament_cmake forbids more than one ament_package() call
       per CMake configure run -- and the vendored rpg_vikit/{vikit_common,
       vikit_ros} subtrees each call ament_package() themselves. Dropping
       this export tag is the documented ament idiom for "this CMakeLists.txt
       is plain CMake with ament targets, but is not itself an ament package";
       see the rpg_vikit vendoring comment block in CMakeLists.txt. -->
</package>
